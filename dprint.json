{
	"useTabs": true,
	"indentWidth": 4,
	"lineWidth": 120,
	"newLineKind": "lf",
	"json": {
		"trailingCommas": "never"
	},
	"markdown": {},
	"oxc": {},
	"excludes": [
		"**/*-lock.json",
		"**/node_modules",
		"shfmt.js",
		"shfmt_esm.js",
		"shfmt_node.js",
		"shfmt_vite.js",
		"shfmt_web.d.ts",
		"shfmt_web.js",
		"shfmt.wasm.d.ts",
		"shfmt_factory.js",
		"shfmt_factory.d.ts"
	],
	"plugins": [
		"https://plugins.dprint.dev/json-0.21.1.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/oxc-0.10.0.wasm"
	]
}
